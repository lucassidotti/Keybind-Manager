#!/usr/bin/env bash
# Omarchy Keybind Manager — user-owned keybinding manager for Hyprland.
set -euo pipefail

readonly STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/keybind-manager"
readonly STATE_FILE="$STATE_DIR/bindings.json"
readonly HYPR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
readonly GENERATED_FILE="$HYPR_DIR/keybind-manager.lua"
readonly MANAGED_HEADER='-- Managed by Omarchy Keybind Manager. Do not edit this file.'
case "${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}" in es*|ES*) readonly UI_LANGUAGE=es ;; *) readonly UI_LANGUAGE=en ;; esac

t() {
  local key=$1; shift
  case "$UI_LANGUAGE:$key" in
    es:missing_dependency) printf 'Falta la dependencia requerida: %s' "$1" ;;
    en:missing_dependency) printf 'Missing required dependency: %s' "$1" ;;
    es:invalid_state) printf 'El estado no contiene JSON válido: %s' "$1" ;;
    en:invalid_state) printf 'State does not contain valid JSON: %s' "$1" ;;
    es:choose_app) printf '¿Qué querés asignar?' ;; en:choose_app) printf 'What do you want to assign?' ;;
    es:installed_app) printf 'Aplicación instalada' ;; en:installed_app) printf 'Installed application' ;;
    es:custom_command) printf 'Comando personalizado' ;; en:custom_command) printf 'Custom command' ;;
    es:cancel) printf 'Cancelar' ;; en:cancel) printf 'Cancel' ;;
    es:find_app) printf 'Buscar aplicación…' ;; en:find_app) printf 'Search applications…' ;;
    es:app_name) printf 'Nombre para el atajo' ;; en:app_name) printf 'Shortcut name' ;;
    es:command) printf 'Comando a ejecutar' ;; en:command) printf 'Command to run' ;;
    es:required) printf 'El nombre y el comando son obligatorios.' ;; en:required) printf 'A name and command are required.' ;;
    es:shortcut_for) printf 'Atajo para %s' "$1" ;; en:shortcut_for) printf 'Shortcut for %s' "$1" ;;
    es:invalid_shortcut) printf 'Formato inválido. Usá, por ejemplo: SUPER + SHIFT + M.' ;; en:invalid_shortcut) printf 'Invalid format. Use, for example: SUPER + SHIFT + M.' ;;
    es:conflict) printf '%s ya está asignado a: %s' "$1" "$2" ;; en:conflict) printf '%s is already assigned to: %s' "$1" "$2" ;;
    es:suggestion) printf 'Usar sugerencia: %s' "$1" ;; en:suggestion) printf 'Use suggestion: %s' "$1" ;;
    es:overwrite) printf 'Sobrescribir %s' "$1" ;; en:overwrite) printf 'Overwrite %s' "$1" ;;
    es:ready) printf 'Listo: %s abre %s.' "$1" "$2" ;; en:ready) printf 'Done: %s opens %s.' "$1" "$2" ;;
    es:another) printf '¿Asignar otro atajo?' ;; en:another) printf 'Assign another shortcut?' ;;
    es:no_bindings) printf 'Todavía no hay atajos creados con este gestor.' ;; en:no_bindings) printf 'There are no shortcuts created with this manager yet.' ;;
    es:columns) printf 'Atajo,Aplicación,Comando' ;; en:columns) printf 'Shortcut,Application,Command' ;;
    es:continue) printf 'Enter para volver' ;; en:continue) printf 'Press Enter to return' ;;
    es:choose_remove) printf 'Elegí el atajo a eliminar' ;; en:choose_remove) printf 'Choose a shortcut to remove' ;;
    es:remove_confirm) printf '¿Eliminar %s?' "$1" ;; en:remove_confirm) printf 'Remove %s?' "$1" ;;
    es:removed) printf 'Se eliminó %s.' "$1" ;; en:removed) printf '%s was removed.' "$1" ;;
    es:title) printf 'OMARCHY · GESTOR DE ATAJOS' ;; en:title) printf 'OMARCHY · KEYBIND MANAGER' ;;
    es:subtitle) printf 'Atajos personales, integrados con Hyprland.' ;; en:subtitle) printf 'Personal shortcuts, integrated with Hyprland.' ;;
    es:add) printf 'Asignar aplicación' ;; en:add) printf 'Assign application' ;;
    es:list) printf 'Ver mis atajos' ;; en:list) printf 'View my shortcuts' ;;
    es:remove) printf 'Eliminar atajo' ;; en:remove) printf 'Remove shortcut' ;;
    es:exit) printf 'Salir' ;; en:exit) printf 'Exit' ;;
  esac
}

die() { gum style --foreground '#ff6b6b' "$*" >&2; exit 1; }
notice() { gum style --foreground '#a8d5ba' "$*"; }

ensure_state() {
  mkdir -p "$STATE_DIR" "$HYPR_DIR"
  [[ -f $STATE_FILE ]] || printf '[]\n' >"$STATE_FILE"
  jq empty "$STATE_FILE" 2>/dev/null || die "$(t invalid_state "$STATE_FILE")"
}

check_dependencies() {
  local dependency
  for dependency in gum jq hyprctl omarchy uwsm-app; do
    command -v "$dependency" >/dev/null || die "$(t missing_dependency "$dependency")"
  done
}

normalize_key() {
  local raw="${1^^}" part key='' mods=() normalized
  raw="${raw// /}"; raw="${raw//-/+}"
  [[ -n $raw ]] || return 1
  IFS='+' read -r -a parts <<<"$raw"
  for part in "${parts[@]}"; do
    case "$part" in
      SUPER|WIN|META|MOD4) mods+=(SUPER) ;;
      CTRL|CONTROL|CTL) mods+=(CTRL) ;;
      ALT|MOD1) mods+=(ALT) ;;
      SHIFT) mods+=(SHIFT) ;;
      '') return 1 ;;
      *) [[ -z $key && $part =~ ^[A-Z0-9_:]+$ ]] || return 1; key=$part ;;
    esac
  done
  [[ -n $key ]] || return 1
  normalized=''
  for part in SUPER CTRL ALT SHIFT; do
    for modifier in "${mods[@]}"; do
      [[ $modifier == "$part" && " $normalized " != *" $part "* ]] && normalized+="${normalized:+ + }$part"
    done
  done
  [[ -n $normalized ]] && printf '%s + %s\n' "$normalized" "$key" || printf '%s\n' "$key"
}

key_from_menu_line() { normalize_key "${1%%→*}" 2>/dev/null || true; }

binding_conflict() {
  local wanted="$1" line current
  while IFS= read -r line; do
    current="$(key_from_menu_line "$line")"
    [[ $current == "$wanted" ]] && { printf '%s\n' "${line#*→ }"; return 0; }
  done < <(omarchy menu keybindings --print 2>/dev/null || true)
  return 1
}

suggest_key() {
  local original="$1" candidate key suffix
  key="${original##* + }"
  for suffix in 'SHIFT' 'CTRL' 'ALT' 'SHIFT + CTRL' 'SHIFT + ALT' 'CTRL + ALT'; do
    candidate="$(normalize_key "$suffix + $original")" || continue
    [[ -z $(binding_conflict "$candidate" || true) ]] && { printf '%s\n' "$candidate"; return; }
  done
  printf 'SUPER + SHIFT + %s\n' "$key"
}

lua_quote() {
  local value=$1
  value=${value//\\/\\\\}; value=${value//\"/\\\"}; value=${value//$'\n'/\\n}
  printf '"%s"' "$value"
}

write_generated_bindings() {
  local temp entry_key name command
  temp="$(mktemp "$HYPR_DIR/.keybind-manager.XXXXXX")"
  {
    printf '%s\n\n' "$MANAGED_HEADER"
    printf '%s\n' '-- This file is regenerated by omarchy-keybind-manager.'
    printf '%s\n\n' '-- Every managed key is explicitly unbound first so it cleanly overrides Omarchy defaults.'
    while IFS=$'\t' read -r entry_key name command; do
      printf 'hl.unbind(%s)\n' "$(lua_quote "$entry_key")"
      printf 'o.bind(%s, %s, "uwsm-app -- sh -lc " .. o.shell_quote(%s))\n\n' \
        "$(lua_quote "$entry_key")" "$(lua_quote "$name")" "$(lua_quote "$command")"
    done < <(jq -r '.[] | [.key, .name, .command] | @tsv' "$STATE_FILE")
  } >"$temp"
  mv "$temp" "$GENERATED_FILE"
  hyprctl reload >/dev/null 2>&1 || true
}

save_binding() {
  local key=$1 name=$2 command=$3 temp
  temp="$(mktemp "$STATE_DIR/.bindings.XXXXXX")"
  jq --arg key "$key" --arg name "$name" --arg command "$command" \
    '. |= map(select(.key != $key)) + [{key: $key, name: $name, command: $command}]' \
    "$STATE_FILE" >"$temp"
  mv "$temp" "$STATE_FILE"; write_generated_bindings
}

desktop_choices() {
  local name exec file
  declare -A seen=()
  while IFS= read -r -d '' file; do
    name="$(awk -F= '/^Name=/{print substr($0,6); exit}' "$file")"
    exec="$(awk -F= '/^Exec=/{print substr($0,6); exit}' "$file")"
    [[ -n $name && -n $exec && -z ${seen[$name]:-} ]] || continue
    [[ $(awk -F= '/^NoDisplay=/{print $2; exit}' "$file") != true ]] || continue
    exec="$(sed -E 's/[[:space:]]+%[fFuUdDnNickvm]//g' <<<"$exec")"
    seen[$name]=1; printf '%s\t%s\n' "$name" "$exec"
  done < <(find "$HOME/.local/share/applications" /usr/share/applications -maxdepth 1 -type f -name '*.desktop' -print0 2>/dev/null)
}

choose_app() {
  local mode chosen
  mode="$(gum choose --header "$(t choose_app)" "$(t installed_app)" "$(t custom_command)" "$(t cancel)")" || return 1
  case "$mode" in
    "$(t installed_app)")
      chosen="$(desktop_choices | sort -f | gum filter --placeholder "$(t find_app)")" || return 1
      APP_NAME="${chosen%%$'\t'*}"; APP_COMMAND="${chosen#*$'\t'}" ;;
    "$(t custom_command)")
      APP_NAME="$(gum input --header "$(t app_name)" --placeholder 'Music')" || return 1
      APP_COMMAND="$(gum input --header "$(t command)" --placeholder 'spotify')" || return 1
      [[ -n $APP_NAME && -n $APP_COMMAND ]] || die "$(t required)" ;;
    *) return 1 ;;
  esac
}

add_binding() {
  local entered key conflict alternative decision
  choose_app || return 0
  entered="$(gum input --header "$(t shortcut_for "$APP_NAME")" --placeholder 'SUPER + SHIFT + M')" || return 0
  key="$(normalize_key "$entered")" || die "$(t invalid_shortcut)"
  conflict="$(binding_conflict "$key" || true)"
  if [[ -n $conflict ]]; then
    alternative="$(suggest_key "$key")"
    decision="$(gum choose --header "$(t conflict "$key" "$conflict")" "$(t suggestion "$alternative")" "$(t overwrite "$key")" "$(t cancel)")" || return 0
    case "$decision" in "$(t suggestion "$alternative")") key=$alternative ;; "$(t overwrite "$key")") ;; *) return 0 ;; esac
  fi
  save_binding "$key" "$APP_NAME" "$APP_COMMAND"
  notice "$(t ready "$key" "$APP_NAME")"
  gum confirm "$(t another)" && add_binding || true
}

list_bindings() {
  local rows
  rows="$(jq -r '.[] | [.key, .name, .command] | @tsv' "$STATE_FILE")"
  [[ -n $rows ]] || { gum style --faint "$(t no_bindings)"; return; }
  printf '%s\n' "$rows" | gum table --border rounded --print --columns "$(t columns)"
  gum input --placeholder "$(t continue)" >/dev/null || true
}

remove_binding() {
  local selected key temp
  selected="$(jq -r '.[] | "\(.key)\t\(.name)"' "$STATE_FILE" | gum choose --header "$(t choose_remove)")" || return 0
  key="${selected%%$'\t'*}"; gum confirm "$(t remove_confirm "$key")" || return 0
  temp="$(mktemp "$STATE_DIR/.bindings.XXXXXX")"
  jq --arg key "$key" 'map(select(.key != $key))' "$STATE_FILE" >"$temp"
  mv "$temp" "$STATE_FILE"; write_generated_bindings; notice "$(t removed "$key")"
}

main() {
  check_dependencies; ensure_state
  while true; do
    clear
    gum style --border rounded --padding '1 2' --border-foreground '#8aadf4' "$(t title)" "$(t subtitle)"
    case "$(gum choose "$(t add)" "$(t list)" "$(t remove)" "$(t exit)")" in
      "$(t add)") add_binding ;; "$(t list)") list_bindings ;; "$(t remove)") remove_binding ;; *) exit 0 ;;
    esac
  done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  if [[ ${1:-} == '--regenerate' ]]; then
    check_dependencies; ensure_state; write_generated_bindings
  else
    main "$@"
  fi
fi
